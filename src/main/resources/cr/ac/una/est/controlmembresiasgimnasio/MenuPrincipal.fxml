<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox
        alignment="CENTER"
        spacing="18.0"
        xmlns="http://javafx.com/javafx"
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="cr.ac.una.est.controlmembresiasgimnasio.vista.MenuPrincipalController">

    <padding>
        <Insets
                top="30.0"
                right="30.0"
                bottom="30.0"
                left="30.0"/>
    </padding>

    <Label
            text="CONTROL DE MEMBRESÍAS"
            style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

    <Label
            text="Gimnasio"
            style="-fx-font-size: 18px;"/>

    <Button
            text="GESTIÓN DE SOCIOS"
            onAction="#abrirSocios"
            prefWidth="250.0"/>

    <Button
            text="GESTIÓN DE PLANES"
            onAction="#abrirPlanes"
            prefWidth="250.0"/>

    <Button
            text="MEMBRESÍAS Y PAGOS"
            onAction="#abrirPagos"
            prefWidth="250.0"/>

    <Button
            text="SIMULACIÓN DE ACCESO"
            onAction="#abrirAcceso"
            prefWidth="250.0"/>

</VBox>