<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!--
  ControlDeAccesoView.fxml
  QUÉ HACE:    Pantalla de recepción: se escribe la cédula y se ve si el socio puede entrar.
  CONECTADO A: ControladorAcceso. Volver regresa al menú.
-->

<!--
  CONTROL DE ACCESO — pensado para la recepción:
  1) cédula y botones juntos arriba,
  2) el resultado (verde/rojo) es lo más grande de la pantalla,
  3) los datos del socio en una sola fila,
  4) los últimos intentos ocupan el espacio restante.
  El color del resultado lo pone ControladorAcceso.pintarResultado().
-->
<BorderPane xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="cr.ac.una.est.controlmembresiasgimnasio.vista.ControladorAcceso"
            prefWidth="1100"
            prefHeight="700"
            styleClass="pagina-oscura"
            stylesheets="@estilos.css"
            style="-fx-background-color: #0E1116; -fx-font-size: 15px;">

    <!-- BARRA SUPERIOR: volver + título -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20"
              style="-fx-background-color: #0B0F14; -fx-border-color: transparent transparent rgba(212,175,55,0.45) transparent; -fx-border-width: 0 0 1 0;">
            <padding>
                <Insets top="16" right="32" bottom="16" left="32" />
            </padding>

            <Button fx:id="btnVolver" text="← Volver" onAction="#volverMenu" prefHeight="38"
                    style="-fx-background-color: #161B22; -fx-text-fill: #E5E7EB; -fx-border-color: #2A313C; -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;" />

            <Label text="CONTROL DE ACCESO"
                   style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;" />
        </HBox>
    </top>

    <!-- CONTENIDO CENTRADO -->
    <center>
        <VBox alignment="TOP_CENTER">
            <padding>
                <Insets top="28" right="32" bottom="24" left="32" />
            </padding>

            <VBox maxWidth="860" spacing="16" VBox.vgrow="ALWAYS">

                <!-- 1) Cédula y acciones -->
                <HBox alignment="CENTER_LEFT" spacing="12"
                      style="-fx-background-color: #161B22; -fx-background-radius: 12; -fx-border-color: #2A313C; -fx-border-radius: 12;">
                    <padding>
                        <Insets top="16" right="16" bottom="16" left="16" />
                    </padding>

                    <TextField fx:id="txtCedula" promptText="Cédula del socio" prefHeight="48" HBox.hgrow="ALWAYS"
                               maxWidth="Infinity" styleClass="campo"
                               style="-fx-background-color: #0E1116; -fx-background-radius: 8; -fx-border-color: #2A313C; -fx-border-radius: 8; -fx-text-fill: white; -fx-prompt-text-fill: #8B93A1; -fx-highlight-fill: #D4AF37; -fx-highlight-text-fill: #0B0F14; -fx-padding: 8 16 8 16; -fx-font-size: 16px;" />

                    <Button fx:id="btnConsultar" text="Consultar membresía" onAction="#consultarMembresia"
                            prefHeight="48" prefWidth="200"
                            style="-fx-background-color: #161B22; -fx-text-fill: #E5E7EB; -fx-border-color: #2A313C; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 15px; -fx-font-weight: bold; -fx-cursor: hand;" />

                    <Button fx:id="btnVerificar" text="Registrar entrada" onAction="#verificarAcceso"
                            prefHeight="48" prefWidth="200"
                            style="-fx-background-color: #D4AF37; -fx-text-fill: #0B0F14; -fx-background-radius: 8; -fx-font-size: 15px; -fx-font-weight: bold; -fx-cursor: hand;" />
                </HBox>

                <!-- 2) Resultado: el punto focal de la pantalla -->
                <Label fx:id="lblResultado" text="Ingrese el número de cédula del socio"
                       wrapText="true" alignment="CENTER" textAlignment="CENTER"
                       maxWidth="Infinity" minHeight="120" prefHeight="120"
                       style="-fx-background-color: #161B22; -fx-background-radius: 12; -fx-border-color: #2A313C; -fx-border-radius: 12; -fx-border-width: 1.5; -fx-text-fill: #E5E7EB; -fx-font-size: 28px; -fx-font-weight: bold; -fx-padding: 16;" />

                <!-- Detalle específico del resultado (causa, fechas, días) -->
                <Label fx:id="lblDetalle" wrapText="true" alignment="CENTER" textAlignment="CENTER"
                       maxWidth="Infinity" minHeight="40"
                       style="-fx-font-size: 15px; -fx-text-fill: #9CA3AF;"
                       text="Escriba la cédula y elija: Consultar membresía (solo ver el estado) o Registrar entrada (marca el ingreso del socio).">
                    <VBox.margin>
                        <Insets top="-6" bottom="-4" />
                    </VBox.margin>
                </Label>

                <!-- 3) Datos del socio en una fila -->
                <HBox alignment="CENTER"
                      style="-fx-background-color: #161B22; -fx-background-radius: 12; -fx-border-color: #2A313C; -fx-border-radius: 12;">
                    <padding>
                        <Insets top="14" right="16" bottom="14" left="16" />
                    </padding>

                    <VBox alignment="CENTER" spacing="4" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                        <Label text="SOCIO" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #9CA3AF;" />
                        <Label fx:id="lblNombre" text="-" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;" />
                    </VBox>

                    <Region minWidth="1" prefWidth="1" maxWidth="1" style="-fx-background-color: #2A313C;" />

                    <VBox alignment="CENTER" spacing="4" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                        <Label text="PLAN" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #9CA3AF;" />
                        <Label fx:id="lblPlan" text="-" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;" />
                    </VBox>

                    <Region minWidth="1" prefWidth="1" maxWidth="1" style="-fx-background-color: #2A313C;" />

                    <VBox alignment="CENTER" spacing="4" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                        <Label text="VENCIMIENTO" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #9CA3AF;" />
                        <Label fx:id="lblVencimiento" text="-" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;" />
                    </VBox>
                </HBox>

                <!-- 4) Últimos intentos de hoy -->
                <Label text="ÚLTIMOS INTENTOS DE HOY"
                       style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #9CA3AF;">
                    <VBox.margin>
                        <Insets top="4" />
                    </VBox.margin>
                </Label>

                <TableView fx:id="tablaRecientes" minHeight="120" VBox.vgrow="ALWAYS" styleClass="tabla"
                           style="-fx-background-color: #161B22; -fx-border-color: #2A313C; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 14px; -fx-fixed-cell-size: 38px;">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="colHora" prefWidth="100" text="Hora" />
                        <TableColumn fx:id="colSocioReciente" prefWidth="260" text="Socio" />
                        <TableColumn fx:id="colCedulaReciente" prefWidth="140" text="Cédula" />
                        <TableColumn fx:id="colResultadoReciente" prefWidth="140" text="Resultado" />
                    </columns>
                </TableView>
            </VBox>
        </VBox>
    </center>

</BorderPane>
