<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- Gestión de socios: tabla grande a la izquierda y panel de acciones/detalle a la derecha. -->
<BorderPane prefHeight="700.0" prefWidth="1100.0"
            style="-fx-background-color: #F4F6F8; -fx-font-size: 15px;"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="cr.ac.una.est.controlmembresiasgimnasio.vista.SociosController">

   <top>
      <VBox alignment="CENTER" spacing="4.0" style="-fx-background-color: #1F2937;">
         <padding>
            <Insets bottom="18.0" left="20.0" right="20.0" top="18.0" />
         </padding>

         <Label style="-fx-text-fill: white; -fx-font-size: 28px; -fx-font-weight: bold;" text="👥 MENÚ SOCIOS" />
         <Label style="-fx-text-fill: #D1D5DB; -fx-font-size: 14px;" text="Gestión de socios del gimnasio" />
      </VBox>
   </top>

   <center>
      <VBox spacing="12.0">
         <padding>
            <Insets bottom="10.0" left="25.0" right="12.0" top="20.0" />
         </padding>

         <HBox spacing="10.0">
            <TextField fx:id="txtBuscar" prefHeight="42.0" promptText="Buscar por nombre o cédula"
                       style="-fx-background-color: white; -fx-border-color: #D1D5DB; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 8px; -fx-font-size: 15px;"
                       HBox.hgrow="ALWAYS" />

            <Button fx:id="btnBuscar" onAction="#buscarSocio" prefHeight="42.0" prefWidth="130.0"
                    style="-fx-background-color: white; -fx-text-fill: #1F2937; -fx-border-color: #D1D5DB; -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-size: 15px; -fx-font-weight: bold;"
                    text="🔎 Buscar" />
         </HBox>

         <Label style="-fx-text-fill: #1F2937; -fx-font-size: 18px; -fx-font-weight: bold;" text="Socios registrados" />

         <TableView fx:id="tablaSocios" style="-fx-font-size: 14px; -fx-fixed-cell-size: 38px;" VBox.vgrow="ALWAYS">
            <columnResizePolicy>
               <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
            <columns>
               <TableColumn fx:id="colCedula" prefWidth="140.0" text="Cédula" />
               <TableColumn fx:id="colNombre" prefWidth="240.0" text="Nombre" />
               <TableColumn fx:id="colTelefono" prefWidth="140.0" text="Teléfono" />
               <TableColumn fx:id="colCorreo" prefWidth="280.0" text="Correo" />
            </columns>
         </TableView>
      </VBox>
   </center>

   <right>
      <VBox prefWidth="360.0" minWidth="320.0" spacing="12.0">
         <padding>
            <Insets bottom="10.0" left="12.0" right="25.0" top="20.0" />
         </padding>

         <Label style="-fx-text-fill: #1F2937; -fx-font-size: 18px; -fx-font-weight: bold;" text="Acciones" />

         <Button fx:id="btnRegistrar" onAction="#registrarSocio" maxWidth="Infinity" prefHeight="46.0"
                 style="-fx-background-color: #1F2937; -fx-text-fill: white; -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-size: 15px; -fx-font-weight: bold;"
                 text="➕ Registrar" />

         <Button fx:id="btnModificar" onAction="#modificarSocio" maxWidth="Infinity" prefHeight="46.0"
                 style="-fx-background-color: white; -fx-text-fill: #1F2937; -fx-border-color: #D1D5DB; -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-size: 15px; -fx-font-weight: bold;"
                 text="✏ Modificar" />

         <Button fx:id="btnEliminar" onAction="#eliminarSocio" maxWidth="Infinity" prefHeight="46.0"
                 style="-fx-background-color: #DC2626; -fx-text-fill: white; -fx-background-radius: 6; -fx-font-size: 15px; -fx-font-weight: bold;"
                 text="🗑 Eliminar" />

         <VBox spacing="8.0" style="-fx-background-color: #F3F4F6; -fx-background-radius: 7; -fx-padding: 14;">
            <Label style="-fx-text-fill: #1F2937; -fx-font-size: 15px; -fx-font-weight: bold;" text="Información adicional" />

            <Label fx:id="lblContactoEmergencia" wrapText="true"
                   style="-fx-text-fill: #4B5563; -fx-font-size: 14px;"
                   text="Contacto de emergencia: -" />

            <Label fx:id="lblCondicionesMedicas" wrapText="true"
                   style="-fx-text-fill: #4B5563; -fx-font-size: 14px;"
                   text="Condiciones médicas: -" />
         </VBox>
      </VBox>
   </right>

   <bottom>
      <HBox alignment="BOTTOM_RIGHT">
         <padding>
            <Insets bottom="15.0" right="25.0" />
         </padding>

         <Button fx:id="btnVolver" onAction="#volverMenu" prefHeight="40.0" prefWidth="120.0"
                 style="-fx-background-color: #6B7280; -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold; -fx-background-radius: 6;"
                 text="← Volver" />
      </HBox>
   </bottom>

</BorderPane>
