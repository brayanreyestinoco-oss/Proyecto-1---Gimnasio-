<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox maxHeight="400.0"
      maxWidth="600.0"
      minHeight="400.0"
      minWidth="600.0"
      prefHeight="400.0"
      prefWidth="600.0"
      xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="cr.ac.una.est.controlmembresiasgimnasio.vista.SociosController">

   <BorderPane maxHeight="400.0"
               maxWidth="600.0"
               minHeight="400.0"
               minWidth="600.0"
               prefHeight="400.0"
               prefWidth="600.0">

      <!-- ENCABEZADO -->
      <top>

         <VBox alignment="CENTER"
               prefHeight="74.0"
               prefWidth="600.0"
               spacing="4.0"
               style="-fx-background-color: #1F2937;">

            <padding>
               <Insets bottom="12.0"
                       left="15.0"
                       right="15.0"
                       top="12.0" />
            </padding>

            <Label text="👥 MENÚ SOCIOS"
                   style="-fx-text-fill: white;
                          -fx-font-size: 22px;
                          -fx-font-weight: bold;" />

            <Label text="Gestión de socios del gimnasio"
                   style="-fx-text-fill: #D1D5DB;
                          -fx-font-size: 12px;" />

         </VBox>

      </top>


      <!-- CONTENIDO -->
      <center>

         <VBox spacing="8.0">

            <padding>
               <Insets bottom="10.0"
                       left="15.0"
                       right="15.0"
                       top="10.0" />
            </padding>


            <!-- BUSCADOR -->
            <HBox spacing="8.0">

               <TextField fx:id="txtBuscar"
                          promptText="Buscar por nombre o cédula"
                          HBox.hgrow="ALWAYS"
                          style="-fx-background-color: white;
                                 -fx-border-color: #D1D5DB;
                                 -fx-border-radius: 6;
                                 -fx-background-radius: 6;
                                 -fx-padding: 7px;" />


               <Button fx:id="btnBuscar"
                       prefHeight="33.0"
                       prefWidth="89.0"
                       text="🔎 Buscar"
                       onAction="#buscarSocio"
                       style="-fx-background-color: white;
                              -fx-text-fill: #1F2937;
                              -fx-border-color: #D1D5DB;
                              -fx-border-radius: 6;
                              -fx-background-radius: 6;
                              -fx-font-weight: bold;" />


               <Button fx:id="btnModificar"
                       prefHeight="33.0"
                       prefWidth="98.0"
                       text="✏ Modificar"
                       onAction="#modificarSocio"
                       style="-fx-background-color: white;
                              -fx-text-fill: #1F2937;
                              -fx-border-color: #D1D5DB;
                              -fx-border-radius: 6;
                              -fx-background-radius: 6;
                              -fx-font-weight: bold;" />


               <Button fx:id="btnEliminar"
                       prefHeight="33.0"
                       prefWidth="96.0"
                       text="🗑 Eliminar"
                       onAction="#eliminarSocio"
                       style="-fx-background-color: #DC2626;
                              -fx-text-fill: white;
                              -fx-background-radius: 6;
                              -fx-font-weight: bold;" />

            </HBox>


            <!-- REGISTRAR -->
            <Button fx:id="btnRegistrar"
                    prefHeight="27.0"
                    prefWidth="639.0"
                    text="➕ Registrar"
                    onAction="#registrarSocio"
                    style="-fx-background-color: white;
                           -fx-text-fill: #1F2937;
                           -fx-border-color: #D1D5DB;
                           -fx-border-radius: 6;
                           -fx-background-radius: 6;
                           -fx-font-weight: bold;" />


            <!-- TABLA -->
            <Label text="Socios registrados"
                   style="-fx-text-fill: #1F2937;
                          -fx-font-size: 15px;
                          -fx-font-weight: bold;" />


            <TableView fx:id="tablaSocios"
                       prefHeight="145.0"
                       VBox.vgrow="NEVER">

               <columns>

                  <TableColumn fx:id="colCedula"
                               prefWidth="105.0"
                               text="Cédula" />

                  <TableColumn fx:id="colNombre"
                               prefWidth="155.0"
                               text="Nombre" />

                  <TableColumn fx:id="colTelefono"
                               prefWidth="110.0"
                               text="Teléfono" />

                  <TableColumn fx:id="colCorreo"
                               prefWidth="200.0"
                               text="Correo" />

               </columns>

            </TableView>


            <!-- INFORMACIÓN DEL SOCIO SELECCIONADO -->
            <VBox spacing="3.0"
                  style="-fx-background-color: #F3F4F6;
                         -fx-background-radius: 7;
                         -fx-padding: 7;">

               <Label text="Información adicional"
                      style="-fx-text-fill: #1F2937;
                             -fx-font-size: 12px;
                             -fx-font-weight: bold;" />

               <HBox spacing="20.0">

                  <Label fx:id="lblContactoEmergencia"
                         text="Contacto de emergencia: -"
                         style="-fx-text-fill: #4B5563;
                                -fx-font-size: 11px;" />

                  <Label fx:id="lblCondicionesMedicas"
                         text="Condiciones médicas: -"
                         style="-fx-text-fill: #4B5563;
                                -fx-font-size: 11px;" />

               </HBox>

            </VBox>

         </VBox>

      </center>


      <!-- BOTÓN VOLVER -->
      <bottom>

         <HBox alignment="BOTTOM_RIGHT">

            <padding>
               <Insets bottom="10.0"
                       right="10.0" />
            </padding>

            <Button fx:id="btnVolver"
                    prefHeight="30.0"
                    prefWidth="80.0"
                    text="← Volver"
                    onAction="#volverMenu"
                    style="-fx-background-color: #6B7280;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-background-radius: 6;" />

         </HBox>

      </bottom>

   </BorderPane>

</VBox>