<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- Gestión de planes: tabla a la izquierda y formulario de datos a la derecha. -->
<BorderPane prefHeight="700.0"
            prefWidth="1100.0"
            style="-fx-background-color: #F4F6F8; -fx-font-size: 15px;"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="cr.ac.una.est.controlmembresiasgimnasio.vista.PlanesController">

    <top>
        <VBox spacing="10" style="-fx-background-color: #1F2937;">
            <padding>
                <Insets bottom="18" left="25" right="25" top="18" />
            </padding>

            <Label style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white;"
                   text="Gestión de Planes" />

            <HBox spacing="10">
                <TextField fx:id="txtBuscar" prefHeight="42" prefWidth="380"
                           promptText="Nombre del plan"
                           style="-fx-background-color: white; -fx-border-color: #D1D5DB; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 8px; -fx-font-size: 15px;" />

                <Button fx:id="btnBuscar" onAction="#buscarPlan" prefHeight="42" prefWidth="120"
                        style="-fx-background-color: white; -fx-text-fill: #1F2937; -fx-font-size: 15px; -fx-font-weight: bold; -fx-background-radius: 6; -fx-border-color: #D1D5DB; -fx-border-radius: 6;"
                        text="Buscar" />

                <Button fx:id="btnMostrarTodos" onAction="#mostrarTodos" prefHeight="42" prefWidth="160"
                        style="-fx-background-color: white; -fx-text-fill: #1F2937; -fx-font-size: 15px; -fx-font-weight: bold; -fx-background-radius: 6; -fx-border-color: #D1D5DB; -fx-border-radius: 6;"
                        text="Mostrar todos" />
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox>
            <padding>
                <Insets bottom="10" left="25" right="12" top="20" />
            </padding>

            <TableView fx:id="tablaPlanes"
                       style="-fx-background-color: white; -fx-border-color: #D1D5DB; -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-size: 14px; -fx-fixed-cell-size: 38px;"
                       VBox.vgrow="ALWAYS">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colNombre" prefWidth="200" text="Plan" />
                    <TableColumn fx:id="colPrecio" prefWidth="160" text="Precio" />
                    <TableColumn fx:id="colBeneficios" prefWidth="420" text="Beneficios" />
                </columns>
            </TableView>
        </VBox>
    </center>

    <right>
        <VBox spacing="8" prefWidth="400" minWidth="360" style="-fx-background-color: #F4F6F8;">
            <padding>
                <Insets bottom="12" left="12" right="25" top="20" />
            </padding>

            <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1F2937;" text="Datos del plan" />

            <Label style="-fx-font-weight: bold;" text="Tipo" />
            <ComboBox fx:id="cmbTipo" maxWidth="Infinity" prefHeight="40" />

            <Label style="-fx-font-weight: bold;" text="Nombre" />
            <TextField fx:id="txtNombre" prefHeight="40" promptText="Ej. Mensual Plus" />

            <Label style="-fx-font-weight: bold;" text="Precio base (₡)" />
            <TextField fx:id="txtPrecioBase" prefHeight="40" promptText="Ej. 15000" />

            <Label fx:id="lblAjuste" style="-fx-font-weight: bold;" text="Ajuste" />
            <TextField fx:id="txtAjuste" prefHeight="40" />

            <Label style="-fx-font-weight: bold;" text="Beneficios" />
            <TextField fx:id="txtBeneficios" prefHeight="40" promptText="Qué incluye el plan" />

            <Region prefHeight="6" />

            <HBox spacing="8">
                <Button fx:id="btnGuardar" onAction="#guardarPlan" prefHeight="44" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                        style="-fx-background-color: #2563EB; -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold; -fx-background-radius: 6;"
                        text="Guardar" />

                <Button fx:id="btnNuevo" onAction="#nuevoPlan" prefHeight="44" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                        style="-fx-background-color: white; -fx-text-fill: #1F2937; -fx-font-size: 15px; -fx-border-color: #D1D5DB; -fx-border-radius: 6; -fx-background-radius: 6;"
                        text="Nuevo" />

                <Button fx:id="btnEliminar" onAction="#eliminarPlan" prefHeight="44" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                        style="-fx-background-color: #DC2626; -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold; -fx-background-radius: 6;"
                        text="Eliminar" />
            </HBox>
        </VBox>
    </right>

    <bottom>
        <HBox alignment="BOTTOM_RIGHT">
            <padding>
                <Insets bottom="15" right="25" />
            </padding>

            <Button fx:id="btnVolver" onAction="#volverMenu" prefHeight="40" prefWidth="120"
                    style="-fx-background-color: #6B7280; -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold; -fx-background-radius: 6;"
                    text="← Volver" />
        </HBox>
    </bottom>

</BorderPane>
