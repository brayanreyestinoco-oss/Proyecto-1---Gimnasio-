<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="400" prefWidth="565.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cr.ac.una.est.controlmembresiasgimnasio.vista.PlanesController">
    <top>
        <VBox spacing="10">
            <padding>
                <Insets bottom="10" left="15" right="15" top="15" />
            </padding>
            <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Gestión de Planes" />
        </VBox>
    </top>
    <center>
        <TableView fx:id="tablaPlanes">
            <columns>
                <TableColumn fx:id="colNombre" prefWidth="150" text="Plan" />
                <TableColumn fx:id="colPrecio" prefWidth="150" text="Precio" />
                <TableColumn fx:id="colBeneficios" prefWidth="300" text="Beneficios" />
            </columns>
        </TableView>
    </center>
</BorderPane>
