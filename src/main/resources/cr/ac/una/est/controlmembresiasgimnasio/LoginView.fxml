<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- Inicio de sesión. Ocupa toda la ventana; el formulario queda centrado. -->
<BorderPane prefHeight="700" prefWidth="1100"
            style="-fx-background-color: #F4F6F8; -fx-font-size: 15px;"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="cr.ac.una.est.controlmembresiasgimnasio.vista.LoginController">

    <center>
        <VBox alignment="CENTER" spacing="18">

            <padding>
                <Insets bottom="30" left="80" right="80" top="30" />
            </padding>

            <Label style="-fx-font-size: 42px; -fx-font-weight: bold; -fx-text-fill: #1F2937;"
                   text="🏋 GIMNASIO" />

            <Label style="-fx-font-size: 16px; -fx-text-fill: #6B7280;"
                   text="Sistema de Gestión de Membresías" />

            <Region prefHeight="10" />

            <VBox maxWidth="460" prefWidth="460" spacing="6">
                <Label style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1F2937;" text="Usuario" />
                <TextField fx:id="txtUsuario" prefHeight="46" promptText="Ingrese su usuario"
                           style="-fx-background-color: white; -fx-border-color: #D1D5DB; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 8px; -fx-font-size: 16px;" />
            </VBox>

            <VBox maxWidth="460" prefWidth="460" spacing="6">
                <Label style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1F2937;" text="Contraseña" />
                <PasswordField fx:id="txtContrasena" prefHeight="46" promptText="Ingrese su contraseña"
                               style="-fx-background-color: white; -fx-border-color: #D1D5DB; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 8px; -fx-font-size: 16px;" />
            </VBox>

            <Label fx:id="lblMensaje" style="-fx-text-fill: #DC2626; -fx-font-size: 14px;" text="" />

            <Button fx:id="btnIngresar" onAction="#ingresar" prefHeight="50" prefWidth="460"
                    style="-fx-background-color: #1F2937; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-background-radius: 6;"
                    text="🔐 Ingresar" />

        </VBox>
    </center>

    <bottom>
        <HBox alignment="BOTTOM_RIGHT">
            <padding>
                <Insets bottom="20" right="25" />
            </padding>

            <Button fx:id="btnSalir" onAction="#salir" prefHeight="40" prefWidth="120"
                    style="-fx-background-color: #DC2626; -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold; -fx-background-radius: 6;"
                    text="🚪 Salir" />
        </HBox>
    </bottom>

</BorderPane>
