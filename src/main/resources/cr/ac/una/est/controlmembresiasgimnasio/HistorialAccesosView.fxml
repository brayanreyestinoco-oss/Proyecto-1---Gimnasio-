<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- Historial: entradas al gimnasio y consultas de membresía. -->
<BorderPane styleClass="pagina-oscura" stylesheets="@estilos.css" prefHeight="700.0" prefWidth="1200.0"
            style="-fx-background-color: #0E1116; -fx-font-size: 15px;"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="cr.ac.una.est.controlmembresiasgimnasio.vista.HistorialAccesosController">

    <top>
        <VBox spacing="10" style="-fx-background-color: #0B0F14; -fx-border-color: transparent transparent rgba(212,175,55,0.45) transparent; -fx-border-width: 0 0 1 0;">
            <padding>
                <Insets bottom="18" left="25" right="25" top="18" />
            </padding>

            <Label style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white;"
                   text="🕒 HISTORIAL DE ACCESOS" />

            <Label style="-fx-font-size: 14px; -fx-text-fill: #9CA3AF;"
                   text="Historial de intentos permitidos y denegados; consultas de membresía por separado" />

            <!-- FlowPane: si la ventana es angosta, los filtros pasan a otra línea en vez de cortarse. -->
            <FlowPane alignment="CENTER_LEFT" hgap="12" vgap="8">
                <Label style="-fx-text-fill: white; -fx-font-weight: bold;" text="Ver:" />
                <ComboBox styleClass="combo" fx:id="cmbTipo" prefHeight="40" prefWidth="230" />

                <Label style="-fx-text-fill: white; -fx-font-weight: bold;" text="Período:" />
                <ComboBox styleClass="combo" fx:id="cmbPeriodo" prefHeight="40" prefWidth="170" />

                <Label style="-fx-text-fill: white; -fx-font-weight: bold;" text="Resultado:" />
                <ComboBox styleClass="combo" fx:id="cmbResultado" prefHeight="40" prefWidth="210" />

                <TextField styleClass="campo" fx:id="txtBuscar" prefHeight="40" prefWidth="320"
                           promptText="Buscar por cédula o nombre"
                           style="-fx-background-color: #161B22; -fx-border-color: #2A313C; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 8px; -fx-font-size: 15px; -fx-text-fill: white; -fx-prompt-text-fill: #8B93A1; -fx-highlight-fill: #D4AF37; -fx-highlight-text-fill: #0B0F14;" />

                <Button onAction="#cargarHistorial" prefHeight="40" prefWidth="130"
                        style="-fx-background-color: #161B22; -fx-text-fill: #E5E7EB; -fx-font-size: 15px; -fx-font-weight: bold; -fx-background-radius: 6; -fx-border-color: #2A313C; -fx-border-radius: 6;"
                        text="🔄 Actualizar" />

                <Button onAction="#exportarCsv" prefHeight="40" prefWidth="170"
                        style="-fx-background-color: #D4AF37; -fx-text-fill: #0B0F14; -fx-font-size: 15px; -fx-font-weight: bold; -fx-background-radius: 6;"
                        text="Exportar a CSV" />
            </FlowPane>
            <FlowPane alignment="CENTER_LEFT" hgap="12" vgap="8">
                <Label text="Desde:" style="-fx-text-fill: white;" />
                <DatePicker styleClass="fecha" fx:id="fechaDesde" promptText="Opcional" />
                <Label text="Hasta:" style="-fx-text-fill: white;" />
                <DatePicker styleClass="fecha" fx:id="fechaHasta" promptText="Opcional" />
                <ProgressIndicator fx:id="indicadorCarga" visible="false" prefWidth="28" prefHeight="28" />
                <Label text="Fechas y socio: pulse Actualizar. Si deja Desde vacío se usa el período."
                       style="-fx-text-fill: white;" />
            </FlowPane>
        </VBox>
    </top>

    <center>
        <VBox spacing="8">
            <padding>
                <Insets bottom="10" left="25" right="25" top="20" />
            </padding>

            <TableView styleClass="tabla" fx:id="tablaAccesos"
                       style="-fx-background-color: #161B22; -fx-border-color: #2A313C; -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-size: 14px; -fx-fixed-cell-size: 38px;"
                       VBox.vgrow="ALWAYS">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colFechaHora" prefWidth="190" text="Fecha y hora" />
                    <TableColumn fx:id="colSocio" prefWidth="240" text="Socio" />
                    <TableColumn fx:id="colCedula" prefWidth="140" text="Cédula" />
                    <TableColumn fx:id="colResultado" prefWidth="130" text="Resultado" />
                    <TableColumn fx:id="colMotivo" prefWidth="220" text="Motivo" />
                </columns>
            </TableView>

            <Label fx:id="lblResumen" style="-fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold;" />
        </VBox>
    </center>

    <bottom>
        <HBox alignment="BOTTOM_RIGHT">
            <padding>
                <Insets bottom="15" right="25" />
            </padding>

            <Button onAction="#volverMenu" prefHeight="40" prefWidth="120"
                    style="-fx-background-color: #161B22; -fx-text-fill: #E5E7EB; -fx-font-size: 15px; -fx-font-weight: bold; -fx-background-radius: 6; -fx-border-color: #2A313C; -fx-border-radius: 6;"
                    text="← Volver" />
        </HBox>
    </bottom>

</BorderPane>