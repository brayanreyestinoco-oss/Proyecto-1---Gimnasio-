<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- Pantalla del menú principal. Ocupa toda la ventana (que se abre maximizada). -->
<BorderPane fx:id="raiz"
            prefHeight="650.0" prefWidth="1000.0"
            style="-fx-background-color: #F4F6F8;"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="cr.ac.una.est.controlmembresiasgimnasio.vista.MenuPrincipalController">

    <!-- ENCABEZADO -->
    <top>
        <VBox alignment="CENTER"
              spacing="5.0"
              style="-fx-background-color: #1F2937;">

            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
            </padding>

            <Label style="-fx-text-fill: white;
                           -fx-font-size: 26px;
                           -fx-font-weight: bold;"
                   text="MENU PRINCIPAL 📚"/>

            <Label style="-fx-text-fill: #D1D5DB;
                           -fx-font-size: 13px;"
                   text="Sistema de Gestión de Membresías"/>
        </VBox>
    </top>

    <!-- MENÚ: botones centrados con un ancho fijo para que no se estiren demasiado. -->
    <center>
        <ScrollPane fitToHeight="true"
                    fitToWidth="true"
                    hbarPolicy="NEVER"
                    style="-fx-background-color: transparent;"
                    vbarPolicy="AS_NEEDED">
            <content>
                <VBox alignment="CENTER"
                      spacing="12.0">

                    <padding>
                        <Insets bottom="20.0" left="30.0" right="30.0" top="20.0"/>
                    </padding>

                    <Button maxWidth="480.0" prefWidth="480.0"
                            mnemonicParsing="false"
                            prefHeight="46.0"
                            onAction="#abrirSocios"
                            style="-fx-background-color: white;
                                   -fx-text-fill: #1F2937;
                                   -fx-font-size: 16px;
                                   -fx-font-weight: bold;
                                   -fx-background-radius: 8px;
                                   -fx-border-radius: 8px;
                                   -fx-border-color: #D1D5DB;"
                            text="👥  Socios"/>

                    <Button maxWidth="480.0" prefWidth="480.0"
                            mnemonicParsing="false"
                            prefHeight="46.0"
                            onAction="#abrirPlanes"
                            style="-fx-background-color: white;
                                   -fx-text-fill: #1F2937;
                                   -fx-font-size: 16px;
                                   -fx-font-weight: bold;
                                   -fx-background-radius: 8px;
                                   -fx-border-radius: 8px;
                                   -fx-border-color: #D1D5DB;"
                            text="📋  Planes"/>

                    <Button maxWidth="480.0" prefWidth="480.0"
                            mnemonicParsing="false"
                            prefHeight="46.0"
                            onAction="#abrirPagos"
                            style="-fx-background-color: white;
                                   -fx-text-fill: #1F2937;
                                   -fx-font-size: 16px;
                                   -fx-font-weight: bold;
                                   -fx-background-radius: 8px;
                                   -fx-border-radius: 8px;
                                   -fx-border-color: #D1D5DB;"
                            text="💰  Pagos"/>

                    <!-- FACTURACIÓN: facturas de los clientes y exportación a Word. -->
                    <Button maxWidth="480.0" prefWidth="480.0"
                            mnemonicParsing="false"
                            prefHeight="46.0"
                            onAction="#abrirFacturacion"
                            style="-fx-background-color: white;
                                   -fx-text-fill: #1F2937;
                                   -fx-font-size: 16px;
                                   -fx-font-weight: bold;
                                   -fx-background-radius: 8px;
                                   -fx-border-radius: 8px;
                                   -fx-border-color: #D1D5DB;"
                            text="🧾  Facturación"/>

                    <Button maxWidth="480.0" prefWidth="480.0"
                            mnemonicParsing="false"
                            prefHeight="46.0"
                            onAction="#abrirAcceso"
                            style="-fx-background-color: white;
                                   -fx-text-fill: #1F2937;
                                   -fx-font-size: 16px;
                                   -fx-font-weight: bold;
                                   -fx-background-radius: 8px;
                                   -fx-border-radius: 8px;
                                   -fx-border-color: #D1D5DB;"
                            text="🛡  Control de Accesos"/>

                    <!-- HISTORIAL DE ACCESOS: quién entró y cuándo. -->
                    <Button maxWidth="480.0" prefWidth="480.0"
                            mnemonicParsing="false"
                            prefHeight="46.0"
                            onAction="#abrirHistorialAccesos"
                            style="-fx-background-color: white;
                                   -fx-text-fill: #1F2937;
                                   -fx-font-size: 16px;
                                   -fx-font-weight: bold;
                                   -fx-background-radius: 8px;
                                   -fx-border-radius: 8px;
                                   -fx-border-color: #D1D5DB;"
                            text="🕒  Historial de Accesos"/>

                    <Button maxWidth="480.0" prefWidth="480.0"
                            mnemonicParsing="false"
                            prefHeight="46.0"
                            onAction="#abrirReportes"
                            style="-fx-background-color: white;
                                   -fx-text-fill: #1F2937;
                                   -fx-font-size: 16px;
                                   -fx-font-weight: bold;
                                   -fx-background-radius: 8px;
                                   -fx-border-radius: 8px;
                                   -fx-border-color: #D1D5DB;"
                            text="📖  Reportes"/>

                    <Button maxWidth="480.0" prefWidth="480.0"
                            mnemonicParsing="false"
                            prefHeight="46.0"
                            onAction="#cerrarSesion"
                            style="-fx-background-color: #DC2626;
                                   -fx-text-fill: white;
                                   -fx-font-size: 16px;
                                   -fx-font-weight: bold;
                                   -fx-background-radius: 8px;"
                            text="🔒  Cerrar Sesión"/>

                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>