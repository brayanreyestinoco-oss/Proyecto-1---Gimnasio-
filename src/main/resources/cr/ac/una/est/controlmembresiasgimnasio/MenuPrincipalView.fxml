<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="400.0" prefWidth="600.0"
      style="-fx-background-color: #F4F6F8;"
      xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="cr.ac.una.est.controlmembresiasgimnasio.vista.MenuPrincipalController">

    <children>

        <BorderPane prefHeight="400.0" prefWidth="600.0">

            <!-- ENCABEZADO -->
            <top>
                <VBox alignment="CENTER"
                      spacing="5.0"
                      style="-fx-background-color: #1F2937;">

                    <padding>
                        <Insets bottom="15.0"
                                left="20.0"
                                right="20.0"
                                top="15.0"/>
                    </padding>

                    <Label style="-fx-text-fill: white;
                                   -fx-font-size: 22px;
                                   -fx-font-weight: bold;"
                           text="MENU PRINCIPAL 📚"/>

                    <Label style="-fx-text-fill: #D1D5DB;
                                   -fx-font-size: 12px;"
                           text="Sistema de Gestión de Membresías"/>
                </VBox>
            </top>

            <!-- MENÚ -->
            <center>
                <ScrollPane fitToHeight="true"
                            fitToWidth="true"
                            hbarPolicy="NEVER"
                            style="-fx-background-color: transparent;"
                            vbarPolicy="AS_NEEDED">

                    <content>
                        <VBox alignment="TOP_CENTER"
                              spacing="10.0">

                            <padding>
                                <Insets bottom="20.0"
                                        left="30.0"
                                        right="30.0"
                                        top="20.0"/>
                            </padding>

                            <!-- SOCIOS -->
                            <Button maxWidth="Infinity"
                                    mnemonicParsing="false"
                                    prefHeight="42.0"
                                    onAction="#abrirSocios"
                                    style="-fx-background-color: white;
                                           -fx-text-fill: #1F2937;
                                           -fx-font-size: 15px;
                                           -fx-font-weight: bold;
                                           -fx-background-radius: 8px;
                                           -fx-border-radius: 8px;
                                           -fx-border-color: #D1D5DB;"
                                    text="👥  Socios"/>

                            <!-- PLANES -->
                            <Button maxWidth="Infinity"
                                    mnemonicParsing="false"
                                    prefHeight="42.0"
                                    onAction="#abrirPlanes"
                                    style="-fx-background-color: white;
                                           -fx-text-fill: #1F2937;
                                           -fx-font-size: 15px;
                                           -fx-font-weight: bold;
                                           -fx-background-radius: 8px;
                                           -fx-border-radius: 8px;
                                           -fx-border-color: #D1D5DB;"
                                    text="📋  Planes"/>

                            <!-- PAGOS -->
                            <Button maxWidth="Infinity"
                                    mnemonicParsing="false"
                                    prefHeight="42.0"
                                    onAction="#abrirPagos"
                                    style="-fx-background-color: white;
                                           -fx-text-fill: #1F2937;
                                           -fx-font-size: 15px;
                                           -fx-font-weight: bold;
                                           -fx-background-radius: 8px;
                                           -fx-border-radius: 8px;
                                           -fx-border-color: #D1D5DB;"
                                    text="💰  Pagos"/>

                            <!-- CONTROL DE ACCESOS -->
                            <Button maxWidth="Infinity"
                                    mnemonicParsing="false"
                                    prefHeight="42.0"
                                    onAction="#abrirAcceso"
                                    style="-fx-background-color: white;
                                           -fx-text-fill: #1F2937;
                                           -fx-font-size: 15px;
                                           -fx-font-weight: bold;
                                           -fx-background-radius: 8px;
                                           -fx-border-radius: 8px;
                                           -fx-border-color: #D1D5DB;"
                                    text="🛡  Control de Accesos"/>

                            <!-- REPORTES -->
                            <Button maxWidth="Infinity"
                                    mnemonicParsing="false"
                                    prefHeight="42.0"
                                    onAction="#abrirReportes"
                                    style="-fx-background-color: white;
                                           -fx-text-fill: #1F2937;
                                           -fx-font-size: 15px;
                                           -fx-font-weight: bold;
                                           -fx-background-radius: 8px;
                                           -fx-border-radius: 8px;
                                           -fx-border-color: #D1D5DB;"
                                    text="📖  Reportes"/>

                            <!-- SALIR -->
                            <Button maxWidth="Infinity"
                                    mnemonicParsing="false"
                                    prefHeight="42.0"
                                    onAction="#salir"
                                    style="-fx-background-color: #DC2626;
                                           -fx-text-fill: white;
                                           -fx-font-size: 15px;
                                           -fx-font-weight: bold;
                                           -fx-background-radius: 8px;"
                                    text="🚪  SALIR"/>

                        </VBox>
                    </content>

                </ScrollPane>
            </center>

            <!-- BOTÓN VOLVER -->
            <bottom>
                <HBox alignment="BOTTOM_RIGHT"
                      prefHeight="45.0"
                      prefWidth="600.0">

                    <padding>
                        <Insets bottom="10.0"
                                right="10.0"/>
                    </padding>

                </HBox>
            </bottom>

        </BorderPane>

    </children>

</VBox>