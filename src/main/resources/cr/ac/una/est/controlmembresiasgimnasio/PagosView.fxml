<?xml version="1.0" encoding="UTF-8"?>

<!-- Importa Insets para configurar los espacios internos de los contenedores. -->
<?import javafx.geometry.Insets?>
<!-- Importa Button para crear los botones de la interfaz. -->
<?import javafx.scene.control.Button?>
<!-- Importa Label para mostrar títulos y textos informativos. -->
<?import javafx.scene.control.Label?>
<!-- Importa TableColumn para definir las columnas de la tabla. -->
<?import javafx.scene.control.TableColumn?>
<!-- Importa TableView para mostrar la información de los pagos. -->
<?import javafx.scene.control.TableView?>
<!-- Importa TextField para permitir al usuario ingresar texto de búsqueda. -->
<?import javafx.scene.control.TextField?>
<!-- Importa BorderPane para dividir la pantalla en diferentes regiones. -->
<?import javafx.scene.layout.BorderPane?>
<!-- Importa HBox para organizar elementos horizontalmente. -->
<?import javafx.scene.layout.HBox?>
<!-- Importa VBox para organizar elementos verticalmente. -->
<?import javafx.scene.layout.VBox?>

<!-- Contenedor principal de la pantalla de gestión de pagos. -->
<!-- El controlador asociado se encarga de manejar las acciones de esta vista. -->
<BorderPane prefHeight="400"
            prefWidth="600"
            style="-fx-background-color: #F4F6F8;"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="cr.ac.una.est.controlmembresiasgimnasio.vista.PagosController">

    <!-- ENCABEZADO -->
    <!-- Parte superior de la pantalla que contiene el título, descripción y buscador. -->
    <top>

        <!-- Contenedor vertical para organizar los elementos del encabezado. -->
        <VBox spacing="10"
              style="-fx-background-color: #1F2937;">

            <!-- Espaciado interno del encabezado. -->
            <padding>
                <Insets bottom="10"
                        left="15"
                        right="15"
                        top="15"/>
            </padding>

            <!-- Título principal de la pantalla de gestión de pagos. -->
            <Label text="💳 GESTIÓN DE PAGOS"
                   style="-fx-font-size: 20px;
                          -fx-font-weight: bold;
                          -fx-text-fill: white;"/>

            <!-- Descripción de las funciones disponibles en esta pantalla. -->
            <Label text="Administración de pagos y membresías"
                   style="-fx-font-size: 12px;
                          -fx-text-fill: #D1D5DB;"/>

            <!-- BUSCADOR -->
            <!-- Contenedor horizontal para los controles de búsqueda. -->
            <HBox spacing="10">

                <!-- Campo de texto utilizado para buscar pagos por cédula o nombre. -->
                <TextField fx:id="txtBuscar"
                           prefWidth="300"
                           promptText="Buscar por cédula o nombre"
                           style="-fx-background-color: white;
                                  -fx-border-color: #D1D5DB;
                                  -fx-border-radius: 6;
                                  -fx-background-radius: 6;
                                  -fx-padding: 7px;"/>

                <!-- Botón que ejecuta la búsqueda de pagos. -->
                <!-- Llama al método buscarPago del controlador. -->
                <Button fx:id="btnBuscar"
                        text="🔎 Buscar"
                        onAction="#buscarPago"
                        style="-fx-background-color: white;
                               -fx-text-fill: #1F2937;
                               -fx-font-weight: bold;
                               -fx-background-radius: 6;
                               -fx-border-color: #D1D5DB;
                               -fx-border-radius: 6;"/>

                <!-- Botón que permite mostrar nuevamente todos los pagos registrados. -->
                <!-- Llama al método mostrarTodos del controlador. -->
                <Button fx:id="btnMostrarTodos"
                        text="Mostrar todos"
                        onAction="#mostrarTodos"
                        style="-fx-background-color: white;
                               -fx-text-fill: #1F2937;
                               -fx-font-weight: bold;
                               -fx-background-radius: 6;
                               -fx-border-color: #D1D5DB;
                               -fx-border-radius: 6;"/>

            </HBox>

        </VBox>

    </top>


    <!-- CONTENIDO -->
    <!-- Parte central de la pantalla donde se muestran los pagos registrados. -->
    <center>

        <!-- Contenedor vertical que agrupa la tabla y el botón para registrar pagos. -->
        <VBox spacing="10">

            <!-- Espaciado interno alrededor del contenido. -->
            <padding>
                <Insets bottom="10"
                        left="10"
                        right="10"
                        top="10"/>
            </padding>

            <!-- Tabla donde se muestran los pagos y la información de las membresías. -->
            <TableView fx:id="tablaPagos"
                       style="-fx-background-color: white;
                              -fx-border-color: #D1D5DB;
                              -fx-border-radius: 6;
                              -fx-background-radius: 6;"
                       VBox.vgrow="ALWAYS">

                <!-- Columnas que forman parte de la tabla de pagos. -->
                <columns>

                    <!-- Columna que muestra la cédula del socio. -->
                    <TableColumn fx:id="colCedula"
                                 prefWidth="85"
                                 text="Cédula"/>

                    <!-- Columna que muestra el nombre del socio. -->
                    <TableColumn fx:id="colSocio"
                                 prefWidth="120"
                                 text="Socio"/>

                    <!-- Columna que muestra el plan asociado al pago. -->
                    <TableColumn fx:id="colPlan"
                                 prefWidth="80"
                                 text="Plan"/>

                    <!-- Columna que muestra la fecha en que se realizó el pago. -->
                    <TableColumn fx:id="colFechaPago"
                                 prefWidth="100"
                                 text="Fecha pago"/>

                    <!-- Columna que muestra el monto pagado. -->
                    <TableColumn fx:id="colMonto"
                                 prefWidth="85"
                                 text="Monto"/>

                    <!-- Columna que muestra la fecha de vencimiento de la membresía. -->
                    <TableColumn fx:id="colVencimiento"
                                 prefWidth="105"
                                 text="Vencimiento"/>

                </columns>

            </TableView>

            <!-- Botón utilizado para abrir el formulario de registro de un nuevo pago. -->
            <!-- Llama al método registrarPago del controlador. -->
            <Button fx:id="btnRegistrar"
                    text="➕ Registrar pago"
                    onAction="#registrarPago"
                    prefHeight="30"
                    prefWidth="580"
                    style="-fx-background-color: #1F2937;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-background-radius: 6;"/>

        </VBox>

    </center>


    <!-- BOTÓN VOLVER -->
    <!-- Parte inferior de la pantalla donde se encuentra el botón para regresar. -->
    <bottom>

        <!-- Contenedor horizontal que coloca el botón en la esquina inferior derecha. -->
        <HBox alignment="BOTTOM_RIGHT">

            <!-- Espaciado interno alrededor del botón. -->
            <padding>
                <Insets bottom="10"
                        right="10"/>
            </padding>

            <!-- Botón utilizado para regresar al menú principal. -->
            <!-- Llama al método volverMenu del controlador. -->
            <Button fx:id="btnVolver"
                    prefHeight="30"
                    prefWidth="80"
                    text="← Volver"
                    onAction="#volverMenu"
                    style="-fx-background-color: #6B7280;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-background-radius: 6;"/>

        </HBox>

    </bottom>

</BorderPane>