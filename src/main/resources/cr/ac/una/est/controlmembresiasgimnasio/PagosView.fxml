<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- Gestión de pagos: encabezado con búsqueda y tabla que ocupa el resto de la pantalla. -->
<BorderPane styleClass="pagina-oscura" stylesheets="@estilos.css" prefHeight="700" prefWidth="1100.0"
            style="-fx-background-color: #0E1116; -fx-font-size: 15px;"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="cr.ac.una.est.controlmembresiasgimnasio.vista.PagosController">

    <top>
        <VBox spacing="10" style="-fx-background-color: #0B0F14; -fx-border-color: transparent transparent rgba(212,175,55,0.45) transparent; -fx-border-width: 0 0 1 0;">
            <padding>
                <Insets bottom="18" left="25" right="25" top="18" />
            </padding>

            <Label style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white;" text="💳 GESTIÓN DE PAGOS" />

            <Label style="-fx-font-size: 14px; -fx-text-fill: #9CA3AF;" text="Administración de pagos y membresías" />

            <HBox spacing="10">
                <TextField styleClass="campo" fx:id="txtBuscar" prefHeight="42" prefWidth="420" promptText="Buscar por cédula o nombre"
                           style="-fx-background-color: #161B22; -fx-border-color: #2A313C; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 8px; -fx-font-size: 15px; -fx-text-fill: white; -fx-prompt-text-fill: #8B93A1; -fx-highlight-fill: #D4AF37; -fx-highlight-text-fill: #0B0F14;" />

                <Button fx:id="btnBuscar" onAction="#buscarPago" prefHeight="42" prefWidth="130"
                        style="-fx-background-color: #161B22; -fx-text-fill: #E5E7EB; -fx-font-size: 15px; -fx-font-weight: bold; -fx-background-radius: 6; -fx-border-color: #2A313C; -fx-border-radius: 6;"
                        text="🔎 Buscar" />

                <Button fx:id="btnMostrarTodos" onAction="#mostrarTodos" prefHeight="42" prefWidth="160"
                        style="-fx-background-color: #161B22; -fx-text-fill: #E5E7EB; -fx-font-size: 15px; -fx-font-weight: bold; -fx-background-radius: 6; -fx-border-color: #2A313C; -fx-border-radius: 6;"
                        text="Mostrar todos" />
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="12">
            <padding>
                <Insets bottom="10" left="25" right="25" top="20" />
            </padding>

            <TableView styleClass="tabla" fx:id="tablaPagos"
                       style="-fx-background-color: #161B22; -fx-border-color: #2A313C; -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-size: 14px; -fx-fixed-cell-size: 38px;"
                       VBox.vgrow="ALWAYS">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colCedula" prefWidth="130" text="Cédula" />
                    <TableColumn fx:id="colSocio" prefWidth="220" text="Socio" />
                    <TableColumn fx:id="colPlan" prefWidth="120" text="Plan" />
                    <TableColumn fx:id="colFechaPago" prefWidth="130" text="Fecha pago" />
                    <TableColumn fx:id="colMonto" prefWidth="120" text="Monto" />
                    <TableColumn fx:id="colVencimiento" prefWidth="130" text="Vencimiento" />
                    <TableColumn fx:id="colMetodoPago" prefWidth="130" text="Método" />
                </columns>
            </TableView>

            <Button fx:id="btnRegistrar" onAction="#registrarPago" maxWidth="Infinity" prefHeight="46.0"
                    style="-fx-background-color: #D4AF37; -fx-text-fill: #0B0F14; -fx-font-size: 16px; -fx-font-weight: bold; -fx-background-radius: 6;"
                    text="➕ Registrar pago" />
        </VBox>
    </center>

    <bottom>
        <HBox alignment="BOTTOM_RIGHT">
            <padding>
                <Insets bottom="15" right="25" />
            </padding>

            <Button fx:id="btnVolver" onAction="#volverMenu" prefHeight="40" prefWidth="120"
                    style="-fx-background-color: #161B22; -fx-text-fill: #E5E7EB; -fx-font-size: 15px; -fx-font-weight: bold; -fx-background-radius: 6; -fx-border-color: #2A313C; -fx-border-radius: 6;"
                    text="← Volver" />
        </HBox>
    </bottom>

</BorderPane>
