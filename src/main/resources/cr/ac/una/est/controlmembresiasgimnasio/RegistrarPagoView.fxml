<?xml version="1.0" encoding="UTF-8"?>

<!-- Importa Insets para configurar los espacios internos de los contenedores. -->
<?import javafx.geometry.Insets?>
<!-- Importa Button para crear botones de acción. -->
<?import javafx.scene.control.Button?>
<!-- Importa ComboBox para seleccionar elementos de una lista desplegable. -->
<?import javafx.scene.control.ComboBox?>
<!-- Importa DatePicker para seleccionar una fecha. -->
<?import javafx.scene.control.DatePicker?>
<!-- Importa Label para mostrar textos informativos. -->
<?import javafx.scene.control.Label?>
<!-- Importa TextField para ingresar información en una línea de texto. -->
<?import javafx.scene.control.TextField?>
<!-- Importa BorderPane para organizar la interfaz en diferentes regiones. -->
<?import javafx.scene.layout.BorderPane?>
<!-- Importa GridPane para organizar los campos en filas y columnas. -->
<?import javafx.scene.layout.GridPane?>
<!-- Importa HBox para organizar elementos horizontalmente. -->
<?import javafx.scene.layout.HBox?>
<!-- Importa VBox para organizar elementos verticalmente. -->
<?import javafx.scene.layout.VBox?>

<!-- Contenedor principal de la pantalla de registro de pagos. -->
<!-- Se utiliza el controlador RegistrarPagoController para manejar los eventos de la interfaz. -->
<BorderPane xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="cr.ac.una.est.controlmembresiasgimnasio.vista.RegistrarPagoController"
            prefWidth="600"
            prefHeight="400"
            style="-fx-background-color: #F4F6F8;">

    <!-- ENCABEZADO -->
    <!-- Parte superior de la pantalla donde se muestra el título y la descripción. -->
    <top>

        <!-- Contenedor vertical utilizado para organizar los textos del encabezado. -->
        <VBox spacing="5"
              style="-fx-background-color: #1F2937;">

            <!-- Espaciado interno del encabezado. -->
            <padding>
                <Insets top="15"
                        right="15"
                        bottom="15"
                        left="15"/>
            </padding>

            <!-- Título principal de la pantalla. -->
            <Label text="➕ REGISTRAR PAGO"
                   style="-fx-font-size: 20px;
                          -fx-font-weight: bold;
                          -fx-text-fill: white;"/>

            <!-- Texto descriptivo de la función de la pantalla. -->
            <Label text="Registro de un nuevo pago de membresía"
                   style="-fx-font-size: 13px;
                          -fx-text-fill: #D1D5DB;"/>

        </VBox>

    </top>


    <!-- CONTENIDO PRINCIPAL -->
    <!-- Contiene el formulario utilizado para registrar el pago. -->
    <center>

        <!-- Contenedor vertical que agrupa el formulario y los botones. -->
        <VBox spacing="12">

            <!-- Espaciado interno alrededor del contenido principal. -->
            <padding>
                <Insets top="15"
                        right="30"
                        bottom="10"
                        left="30"/>
            </padding>

            <!-- Organiza los campos del formulario en filas y columnas. -->
            <GridPane hgap="15"
                      vgap="10">


                <!-- CÉDULA -->

                <!-- Etiqueta que identifica el campo de cédula del socio. -->
                <Label text="Cédula del socio:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="0"
                       style="-fx-font-weight: bold;
                              -fx-text-fill: #1F2937;"/>

                <!-- Campo donde se ingresa la cédula del socio. -->
                <TextField fx:id="txtCedula"
                           promptText="Ingrese la cédula"
                           prefWidth="300"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="0"
                           style="-fx-background-color: white;
                                  -fx-border-color: #D1D5DB;
                                  -fx-border-radius: 6;
                                  -fx-background-radius: 6;
                                  -fx-padding: 7px;"/>


                <!-- PLAN -->

                <!-- Etiqueta que identifica el campo para seleccionar el plan. -->
                <Label text="Plan:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="1"
                       style="-fx-font-weight: bold;
                              -fx-text-fill: #1F2937;"/>

                <!-- Lista desplegable donde se selecciona el plan de membresía. -->
                <ComboBox fx:id="cmbPlan"
                          prefWidth="300"
                          promptText="Seleccione un plan"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="1"/>


                <!-- MONTO -->

                <!-- Etiqueta que identifica el monto del pago. -->
                <Label text="Monto:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="2"
                       style="-fx-font-weight: bold;
                              -fx-text-fill: #1F2937;"/>

                <!-- Campo que muestra el monto correspondiente al plan seleccionado. -->
                <!-- El campo no puede ser editado directamente por el usuario. -->
                <TextField fx:id="txtMonto"
                           promptText="Monto del plan"
                           prefWidth="300"
                           editable="false"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="2"
                           style="-fx-background-color: white;
                                  -fx-border-color: #D1D5DB;
                                  -fx-border-radius: 6;
                                  -fx-background-radius: 6;
                                  -fx-padding: 7px;"/>


                <!-- FECHA -->

                <!-- Etiqueta que identifica la fecha en la que se realiza el pago. -->
                <Label text="Fecha de pago:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="3"
                       style="-fx-font-weight: bold;
                              -fx-text-fill: #1F2937;"/>

                <!-- Selector de fecha utilizado para establecer la fecha del pago. -->
                <DatePicker fx:id="dpFechaInicio"
                            prefWidth="300"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="3"/>


                <!-- MÉTODO DE PAGO -->

                <!-- Etiqueta que identifica el método utilizado para realizar el pago. -->
                <Label text="Método de pago:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="4"
                       style="-fx-font-weight: bold;
                              -fx-text-fill: #1F2937;"/>

                <!-- Lista desplegable para seleccionar el método de pago. -->
                <ComboBox fx:id="cmbMetodoPago"
                          prefWidth="300"
                          promptText="Seleccione el método"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="4"/>


                <!-- VENCIMIENTO -->

                <!-- Etiqueta que identifica la fecha de vencimiento de la membresía. -->
                <Label text="Vencimiento:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="5"
                       style="-fx-font-weight: bold;
                              -fx-text-fill: #1F2937;"/>

                <!-- Label donde se muestra la fecha de vencimiento calculada automáticamente. -->
                <Label fx:id="lblVencimiento"
                       text="Se calculará automáticamente"
                       prefWidth="300"
                       GridPane.columnIndex="1"
                       GridPane.rowIndex="5"
                       style="-fx-background-color: white;
                              -fx-border-color: #D1D5DB;
                              -fx-border-radius: 6;
                              -fx-background-radius: 6;
                              -fx-padding: 8px;
                              -fx-text-fill: #4B5563;"/>

            </GridPane>


            <!-- BOTONES -->

            <!-- Contenedor horizontal que agrupa los botones de cancelar y guardar. -->
            <HBox spacing="10"
                  alignment="CENTER_RIGHT">

                <!-- Botón utilizado para cancelar el registro del pago. -->
                <Button fx:id="btnCancelar"
                        text="Cancelar"
                        prefWidth="100"
                        onAction="#cancelar"
                        style="-fx-background-color: white;
                               -fx-text-fill: #1F2937;
                               -fx-font-weight: bold;
                               -fx-background-radius: 6;
                               -fx-border-color: #D1D5DB;
                               -fx-border-radius: 6;"/>

                <!-- Botón utilizado para guardar el pago registrado. -->
                <!-- Ejecuta el método guardarPago del controlador. -->
                <Button fx:id="btnGuardar"
                        text="💾 Guardar"
                        prefWidth="100"
                        onAction="#guardarPago"
                        style="-fx-background-color: #1F2937;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-background-radius: 6;"/>

            </HBox>

        </VBox>

    </center>


    <!-- PARTE INFERIOR -->
    <!-- Contiene el botón utilizado para regresar a la pantalla anterior. -->
    <bottom>

        <!-- Contenedor horizontal que coloca el botón en la parte inferior derecha. -->
        <HBox alignment="BOTTOM_RIGHT">

            <!-- Espaciado interno alrededor del botón. -->
            <padding>
                <Insets bottom="10"
                        right="10"/>
            </padding>

            <!-- Botón utilizado para regresar a la pantalla de pagos. -->
            <!-- Ejecuta el método volverPagos del controlador. -->
            <Button fx:id="btnVolver"
                    prefHeight="30"
                    prefWidth="80"
                    text="← Volver"
                    onAction="#volverPagos"
                    style="-fx-background-color: #6B7280;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-background-radius: 6;"/>

        </HBox>

    </bottom>

</BorderPane>