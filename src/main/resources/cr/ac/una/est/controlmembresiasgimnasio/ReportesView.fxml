<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
  ReportesView.fxml
  QUÉ HACE:    Reporte de membresías (todas, por vencer o ya vencidas) con exportación a CSV.
  CONECTADO A: ReportesController. Volver regresa al menú.
-->

<!-- Reporte de membresías: la tabla ocupa todo el ancho y alto disponibles. -->
<BorderPane styleClass="pagina-oscura" stylesheets="@estilos.css" prefHeight="700.0" prefWidth="1200.0"
            style="-fx-background-color: #0E1116; -fx-font-size: 15px;"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="cr.ac.una.est.controlmembresiasgimnasio.vista.ReportesController">

    <top>
        <VBox spacing="10" style="-fx-background-color: #0B0F14; -fx-border-color: transparent transparent rgba(212,175,55,0.45) transparent; -fx-border-width: 0 0 1 0;">
            <padding>
                <Insets bottom="18" left="25" right="25" top="18" />
            </padding>

            <Label style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white;"
                   text="Reporte de Membresías" />

            <HBox alignment="CENTER_LEFT" spacing="12">
                <Label style="-fx-text-fill: white; -fx-font-weight: bold;" text="Mostrar:" />

                <ComboBox styleClass="combo" fx:id="selectorPlazo" prefHeight="40.0" prefWidth="300.0" promptText="Todas las membresías" />

                <Button fx:id="btnActualizar" onAction="#cargarReporte" prefHeight="40" prefWidth="130"
                        style="-fx-background-color: #161B22; -fx-text-fill: #E5E7EB; -fx-font-size: 15px; -fx-font-weight: bold; -fx-background-radius: 6; -fx-border-color: #2A313C; -fx-border-radius: 6;"
                        text="Actualizar" />

                <Button fx:id="btnExportarCsv" onAction="#exportarCsv" prefHeight="40" prefWidth="170"
                        style="-fx-background-color: #D4AF37; -fx-text-fill: #0B0F14; -fx-font-size: 15px; -fx-font-weight: bold; -fx-background-radius: 6;"
                        text="Exportar a CSV" />
            </HBox>

            <Label fx:id="lblEstadoConsulta" style="-fx-text-fill: white; -fx-font-size: 14px;"
                   text="Elija qué membresías mostrar: todas, o solo las activas que están por vencer." />
        </VBox>
    </top>

    <center>
        <VBox>
            <padding>
                <Insets bottom="10" left="25" right="25" top="20" />
            </padding>

            <TableView styleClass="tabla" fx:id="tablaReporte"
                       style="-fx-background-color: #161B22; -fx-border-color: #2A313C; -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-size: 14px; -fx-fixed-cell-size: 38px;"
                       VBox.vgrow="ALWAYS">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colSocio" prefWidth="200.0" text="Socio" />
                    <TableColumn fx:id="colCedula" prefWidth="130.0" text="Cédula" />
                    <TableColumn fx:id="colPlan" prefWidth="110.0" text="Plan" />
                    <TableColumn fx:id="colFechaInicio" prefWidth="120.0" text="Inicio" />
                    <TableColumn fx:id="colFechaVencimiento" prefWidth="130.0" text="Vencimiento" />
                    <TableColumn fx:id="colEstado" prefWidth="100.0" text="Estado" />
                    <TableColumn fx:id="colRenovacionAutomatica" prefWidth="120.0" text="Renov. Auto." />
                    <TableColumn fx:id="colCostoRenovacion" prefWidth="150.0" text="Costo Renovación" />
                    <TableColumn fx:id="colMetodoPago" prefWidth="150.0" text="Método de Pago" />
                </columns>
            </TableView>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="BOTTOM_RIGHT">
            <padding>
                <Insets bottom="15" right="25" />
            </padding>

            <Button fx:id="btnVolver" onAction="#volverMenu" prefHeight="40" prefWidth="120"
                    style="-fx-background-color: #161B22; -fx-text-fill: #E5E7EB; -fx-font-size: 15px; -fx-font-weight: bold; -fx-background-radius: 6; -fx-border-color: #2A313C; -fx-border-radius: 6;"
                    text="← Volver" />
        </HBox>
    </bottom>

</BorderPane>
